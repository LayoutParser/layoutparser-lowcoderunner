<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Config do sidecar HTTP (caminhos locais do Windows; não vêm no request). -->
    <add key="ListenPrefix" value="http://127.0.0.1:5080/" />
    <add key="SysmiddleDir" value="" />
    <add key="GlobalFolder" value="" />
    <add key="Package" value="" />
    <!-- Mantenha 1 até confirmar que as DLLs Sysmiddle são thread-safe. -->
    <add key="MaxConcurrency" value="1" />
    <add key="TimeoutSeconds" value="180" />
    <!-- LogFile: padrão %ProgramData%\LayoutParserLowCodeRunner\logs\runner.log -->
  </appSettings>
</configuration>
